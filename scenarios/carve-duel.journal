# clayfray scenario: chest + head carve with sploot, then a sword pose
# change. Replay: ./build/clayfray --replay scenarios/carve-duel.journal
#   --screenshot out.png --frames 240 --size 640x360 --aa 1
# Deterministic: same binary + same journal = byte-identical screenshot,
# and the conservation gate (exit 3) runs at the end.
30 edit carve 0.02 0.42 0.12 0.07 0.72 0.45 0.4 0 1 0 0.15 0.4 0.45
44 edit carve -0.08 0.60 0.08 0.055 0.72 0.45 0.4 0.2 0.8 0.4 0.15 0.4 0.45
60 set sword.pitch 0.35
60 set look.keyIntensity 16
