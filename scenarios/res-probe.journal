# clayfray scenario: resolution probe. A row of five craters across the chest
# with radii 70/50/35/25/18 mm — the last equals sword.radius (params.h:28),
# the smallest feature the carve system must resolve. Centers sit ON the front
# surface (z=0.20) so every one bites, unlike carve-duel's subsurface grazes.
# Replay: ./build/clayfray --replay scenarios/res-probe.journal
#   --screenshot out.png --frames 240 --size 960x540 --aa 2 --cam 0.30,0.10,1.4
2 set sword.enabled 0
2 set look.keyIntensity 16
6 edit carve -0.13 0.45 0.20 0.07 0.72 0.45 0.4 0 0 1 0.15 0.4 0.45
10 edit carve -0.065 0.45 0.20 0.05 0.72 0.45 0.4 0 0 1 0.15 0.4 0.45
14 edit carve 0.0 0.45 0.20 0.035 0.72 0.45 0.4 0 0 1 0.15 0.4 0.45
18 edit carve 0.065 0.45 0.20 0.025 0.72 0.45 0.4 0 0 1 0.15 0.4 0.45
22 edit carve 0.13 0.45 0.20 0.018 0.72 0.45 0.4 0 0 1 0.15 0.4 0.45
